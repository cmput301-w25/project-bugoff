<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="16dp">

    <!-- App Logo -->

    <!-- Name Input -->

    <ImageView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="159dp"
        android:layout_marginEnd="132dp"
        android:contentDescription="App Logo"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintMarginTop="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:background="@drawable/input_field"
        android:hint="Full Name"
        android:padding="15dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#A0A0A0"
        android:textColorLink="#A89B9B"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintMarginEnd="30dp"
        app:layout_constraintMarginStart="30dp"
        app:layout_constraintMarginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <!-- Email Input -->
    <EditText
        android:id="@+id/email"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Email Address"
        android:background="@drawable/input_field"
        android:padding="15dp"
        android:inputType="textEmailAddress"
        android:textColorHint="#A0A0A0"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintMarginTop="15dp"
        app:layout_constraintMarginStart="30dp"
        app:layout_constraintMarginEnd="30dp"/>

    <!-- Password Input -->
    <EditText
        android:id="@+id/password"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Password"
        android:background="@drawable/input_field"
        android:padding="15dp"
        android:inputType="textPassword"
        android:textColorHint="#A0A0A0"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/email"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintMarginTop="15dp"
        app:layout_constraintMarginStart="30dp"
        app:layout_constraintMarginEnd="30dp"/>

    <!-- Sign Up Button -->
    <Button
        android:id="@+id/signup_btn"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:background="@drawable/button_background"
        android:text="Sign Up"
        android:textColor="#FFFFFF"
        android:textColorLink="#0D0505"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintMarginEnd="30dp"
        app:layout_constraintMarginStart="30dp"
        app:layout_constraintMarginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/password" />

    <!-- Already have an account? -->
    <TextView
        android:id="@+id/login_redirect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:text="Already have an account? Log in"
        android:textColor="#0B0707"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/signup_btn" />

</androidx.constraintlayout.widget.ConstraintLayout>