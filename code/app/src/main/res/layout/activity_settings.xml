<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <!-- Title for the Settings Screen -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"/>

    <!-- Switch for Private/Public Profile -->
    <Switch
        android:id="@+id/privacy_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Private Profile"
        android:textSize="16sp"
        android:padding="16dp" />

    <!-- Description for the Switch -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="When enabled, your profile will be visible only to your friends."
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="32dp" />

    <!-- Logout Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/logoutButton"
        android:layout_width="161dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_button_blue"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.05"
        android:padding="10dp"
        android:stateListAnimator="@android:anim/slide_in_left"
        android:text="Logout"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

</LinearLayout>