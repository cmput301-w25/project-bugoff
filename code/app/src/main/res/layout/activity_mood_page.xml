<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_margin="7dp">

            <!-- Mood Detail RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mood_detail_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"/>

            <!-- Comment Input Layout -->
            <LinearLayout
                android:id="@+id/comment_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginLeft="3dp"
                android:layout_marginRight="3dp"
                android:visibility="gone">
                <EditText
                    android:id="@+id/comment_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Add a comment..."
                    android:inputType="text"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp"/>
                <Button
                    android:id="@+id/comment_confirm_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="?attr/buttonBackgroundColor"
                    android:text="ᗒ"
                    android:textColor="?attr/textColor" />
            </LinearLayout>

            <!-- Comments Label -->
            <TextView
                android:id="@+id/comments_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMENTS:"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="12dp"/>

            <!-- No Comments Text -->
            <TextView
                android:id="@+id/no_comments_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No Comments Yet"
                android:textColor="@android:color/darker_gray"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:visibility="visible"
                android:layout_marginStart="15dp"/>

            <!-- Comments RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/mood_comments_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="17dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/edit_mood_fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:srcCompat="@android:drawable/ic_menu_edit"
        android:contentDescription="Edit Mood" />
</FrameLayout>