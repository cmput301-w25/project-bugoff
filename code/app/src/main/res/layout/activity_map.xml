<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Google Maps Fragment -->
    <fragment
        android:id="@+id/map_fragment"
        class="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Vertical Button Layout on the Left-Bottom Side -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btn_show_my_moods"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:contentDescription="My Moods"
            android:padding="12dp"
            android:src="@drawable/ic_mymoods" />

        <ImageButton
            android:id="@+id/btn_show_following_moods"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@null"
            android:contentDescription="Following"
            android:padding="12dp"
            android:src="@drawable/ic_followers"
            android:layout_marginTop="16dp" />

        <ImageButton
            android:id="@+id/btn_show_both_moods"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_all"
            android:background="@null"
            android:contentDescription="Both"
            android:padding="12dp"
            android:layout_marginTop="16dp" />

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="@null"
            android:contentDescription="Back"
            android:padding="12dp"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</RelativeLayout>
