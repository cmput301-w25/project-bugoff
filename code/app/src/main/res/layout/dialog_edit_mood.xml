<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dialog_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Editing Mood..."
        android:textSize="30sp"
        android:fontFamily="@font/kaushan_script"
        android:textAlignment="center"
        android:layout_marginTop="10dp" />

    <!-- Mood Spinner -->
    <FrameLayout
        android:id="@+id/spinnerFrame"
        android:layout_width="264dp"
        android:layout_height="35dp"
        android:layout_marginTop="20dp"
        android:elevation="6dp"
        android:layout_gravity="center_horizontal">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/input_field">
            <Spinner
                android:id="@+id/moodSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:hint="Click to Select a Mood"
                android:prompt="@string/select_mood"/>
            <ImageView
                android:id="@+id/spinner_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_dropdown" />
        </RelativeLayout>

    </FrameLayout>

    <!-- Reason Input with 200 Character Limit -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reason"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="25dp">

        <EditText
            android:id="@+id/reasonInput"
            android:layout_width="match_parent"
            android:layout_height="146dp"
            android:background="@drawable/input_field"
            android:gravity="start|top"
            android:hint="Add Reason..."
            android:inputType="textMultiLine"
            android:maxLength="200"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray" />
        <TextView
            android:id="@+id/reasonCharCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:padding="4dp"
            android:text="200"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/gray" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:layout_marginHorizontal="70dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Private Mood"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/privacySwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#439DEB"
            android:trackTint="@color/blue"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

    </LinearLayout>
    <!-- Tagging Friends -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addTagButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#439DEB"
        android:layout_gravity="center"
        android:text="Tags"
        app:cornerRadius="14dp"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/taggedFriendsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:hint="Tagged friends will appear here" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            app:cornerRadius="14dp"
            android:backgroundTint="@color/anger_text"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Save"
            app:cornerRadius="14dp"
            android:backgroundTint="#439DEB"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            app:cornerRadius="14dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#439DEB"/>


    </LinearLayout>
</LinearLayout>