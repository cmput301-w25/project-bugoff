<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Emotional State Spinner -->

    <FrameLayout
        android:id="@+id/spinnerFrame"
        android:layout_width="264dp"
        android:layout_height="35dp"
        android:layout_marginTop="25dp"
        android:elevation="6dp"
        android:layout_gravity="center_horizontal">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/input_field">

            <!-- Spinner -->
            <Spinner
                android:id="@+id/moodSpinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:hint="Click to Select a Mood"
                android:prompt="@string/select_mood"/>

            <!-- Dropdown Icon -->
            <ImageView
                android:id="@+id/spinner_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_dropdown" />
        </RelativeLayout>
    </FrameLayout>

    <!-- Trigger Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Trigger"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp" />
    <EditText
        android:id="@+id/triggerInput"
        android:layout_width="match_parent"
        android:background="@drawable/input_field"
        android:padding="15dp"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Add Trigger..." />
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="25dp">

        <EditText
            android:id="@+id/reasonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_field"
            android:padding="15dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray"
            android:hint="Add Reason..."
            android:maxLength="20" />

        <TextView
            android:id="@+id/reasonCharCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:padding="4dp"
            android:text="20"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/gray" />
    </FrameLayout>
    <!-- Reason Input -->

    <!-- Tagging Friends -->

    <AutoCompleteTextView
        android:id="@+id/friendSearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="text"
        android:completionThreshold="1"
        android:background="@drawable/input_field"
        android:padding="15dp"
        android:hint="Search users..."
        android:textAppearance="?android:attr/textAppearanceMedium" />/>
    <Button
        android:id="@+id/addTagButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#439DEB"
        android:text="Add Tag"
        android:layout_marginTop="8dp" />
    <TextView
        android:id="@+id/taggedFriendsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Tagged friends will appear here" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center">
        <Button
            android:id="@+id/deleteButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:backgroundTint="#439DEB"/>
        <Button
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:layout_marginStart="8dp"
            android:backgroundTint="#439DEB"/>
        <Button
            android:id="@+id/saveButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginStart="8dp"
            android:backgroundTint="#439DEB"/>
    </LinearLayout>
</LinearLayout>